      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_5_di" bpmnElement="Lane_5" isHorizontal="true">
        <dc:Bounds x="80" y="1270" width="3140" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_6_di" bpmnElement="Lane_6" isHorizontal="true">
        <dc:Bounds x="80" y="1520" width="3140" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Claim_di" bpmnElement="Start_Claim">
        <dc:Bounds x="288" y="343" width="44" height="44"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register">
        <dc:Bounds x="370" y="315" width="200" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Orient_di" bpmnElement="Task_Orient">
        <dc:Bounds x="610" y="315" width="210" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Immediate_di" bpmnElement="Gateway_Immediate">
        <dc:Bounds x="849" y="339" width="52" height="52"/>
