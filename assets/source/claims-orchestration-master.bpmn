      <bpmndi:BPMNShape id="DataStoreRef_ClaimState_di" bpmnElement="DataStoreRef_ClaimState">
        <dc:Bounds x="2450" y="305" width="450" height="125"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="310.0" y="365.0"/>
        <di:waypoint x="470.0" y="365.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="470.0" y="365.0"/>
        <di:waypoint x="715.0" y="365.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="715.0" y="365.0"/>
        <di:waypoint x="875.0" y="365.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="875.0" y="365.0"/>
        <di:waypoint x="1045.0" y="365.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="875.0" y="365.0"/>
        <di:waypoint x="950.0" y="1112.5"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="950.0" y="1112.5"/>
        <di:waypoint x="1045.0" y="365.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1045.0" y="365.0"/>
        <di:waypoint x="1210.0" y="365.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1210.0" y="365.0"/>
