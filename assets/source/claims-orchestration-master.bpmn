      <bpmndi:BPMNShape id="Gateway_Activate_di" bpmnElement="Gateway_Activate">
        <dc:Bounds x="1184" y="339" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Decision_di" bpmnElement="Sub_Decision">
        <dc:Bounds x="1280" y="305" width="245" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Material_di" bpmnElement="Event_Material">
        <dc:Bounds x="1553" y="343" width="44" height="44"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reevaluate_di" bpmnElement="Task_Reevaluate">
        <dc:Bounds x="1630" y="305" width="245" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Closure_di" bpmnElement="Gateway_Closure">
        <dc:Bounds x="1904" y="339" width="52" height="52"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Close_di" bpmnElement="Task_Close">
        <dc:Bounds x="2010" y="305" width="245" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Claim_di" bpmnElement="End_Claim">
        <dc:Bounds x="2293" y="343" width="44" height="44"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Intelligence_di" bpmnElement="Sub_Intelligence">
        <dc:Bounds x="1270" y="565" width="330" height="125"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Human_di" bpmnElement="Sub_Human">
        <dc:Bounds x="1675" y="815" width="330" height="125"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Fulfil_di" bpmnElement="Sub_Fulfil">
        <dc:Bounds x="1675" y="1065" width="330" height="125"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Comms_di" bpmnElement="Sub_Comms">
        <dc:Bounds x="1270" y="1315" width="330" height="125"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Control_di" bpmnElement="Sub_Control">
        <dc:Bounds x="1270" y="1565" width="330" height="125"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Urgent_di" bpmnElement="Task_Urgent">
        <dc:Bounds x="830" y="1060" width="240" height="105"/>
